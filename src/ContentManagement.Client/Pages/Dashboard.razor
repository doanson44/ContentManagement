@page "/dashboard"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Dashboard · ContentManagement</PageTitle>

@if (_checkingSession)
{
    <div class="dashboard-loading">Checking administrator session…</div>
}
else if (_signedIn)
{
    <div class="dashboard-page dashboard-page-no-sidebar">
        <main class="dashboard-main">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-eyebrow">WORKSPACE OVERVIEW</p>
                    <h1>Dashboard</h1>
                    <p class="dashboard-subtitle">Access the content modules available to your account.</p>
                </div>
                <div class="session-pill"><span></span> Session active</div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="dashboard-message">@_message</div>
            }
            @if (_showWelcome)
            {
                <div class="welcome-notice" role="status">
                    <div><strong>Welcome to ContentManagement!</strong><span>Your account is ready. You can now access your workspace.</span></div>
                    <button type="button" aria-label="Dismiss welcome message" @onclick="DismissWelcome">×</button>
                </div>
            }

            <section class="welcome-panel">
                <div>
                    <p class="welcome-kicker">CONTENT MANAGEMENT</p>
                    <h2>Welcome to your workspace</h2>
                    <p>Manage application configuration and monitor your content platform from one place.</p>
                </div>
                <div class="welcome-decoration" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            </section>

            <div class="section-heading">
                <div><h2>Management</h2><p>Core areas of your content platform</p></div>
                <span class="module-count">@VisibleModuleCount modules</span>
            </div>

            <section class="module-grid" aria-label="Management modules">
                @if (CanAccessFiles)
                {
                    <a class="module-card module-card-link" href="/dashboard/files">
                        <div class="module-icon files-icon">▤</div>
                        <div class="module-card-heading"><h3>File management</h3><span class="module-status">Available</span></div>
                        <p>Browse file metadata, inspect status, and manage stored binary content.</p>
                        <div class="module-footer"><span>Binary assets</span><span class="module-arrow" aria-hidden="true">↗</span></div>
                    </a>
                }
                @if (CanAccessJson)
                {
                    <a class="module-card module-card-link" href="/dashboard/json">
                        <div class="module-icon json-icon">{ }</div>
                        <div class="module-card-heading"><h3>JSON documents</h3><span class="module-status">Available</span></div>
                        <p>Manage JSON documents and their metadata, validation, and lifecycle.</p>
                        <div class="module-footer"><span>Structured content</span><span class="module-arrow" aria-hidden="true">↗</span></div>
                    </a>
                }
            </section>
            @if (VisibleModuleCount == 0)
            {
                <section class="dashboard-empty" role="status">
                    <div class="dashboard-empty-icon">⌁</div>
                    <h2>No modules available</h2>
                    <p>Your account does not currently have access to any dashboard modules. Contact an administrator if you believe this is incorrect.</p>
                </section>
            }
            @if (_isAdministrator)
            {
                <section class="module-grid admin-module-grid" aria-label="Administration">
                    <a class="module-card module-card-link" href="/dashboard/public-html">
                        <div class="module-icon files-icon">▧</div>
                        <div class="module-card-heading"><h3>Public HTML Pages</h3><span class="module-status">Available</span></div>
                        <p>Upload standalone HTML pages and publish them at stable public URLs.</p>
                        <div class="module-footer"><span>Public web content</span><span class="module-arrow" aria-hidden="true">↗</span></div>
                    </a>
                    <a class="module-card module-card-link" href="/dashboard/setup">
                        <div class="module-icon permission-icon">⚙</div>
                        <div class="module-card-heading"><h3>System setup</h3><span class="module-status">Available</span></div>
                        <p>Configure stale-file cleanup and deletion grace periods.</p>
                        <div class="module-footer"><span>System configuration</span><span class="module-arrow" aria-hidden="true">↗</span></div>
                    </a>
                    <a class="module-card module-card-link" href="/dashboard/quick-notes">
                        <div class="module-icon permission-icon">✎</div>
                        <div class="module-card-heading"><h3>Quick Notes</h3><span class="module-status">Available</span></div>
                        <p>Capture personal reminders and ideas with automatic saving.</p>
                        <div class="module-footer"><span>Personal notes</span><span class="module-arrow" aria-hidden="true">↗</span></div>
                    </a>
                    <a class="module-card module-card-link" href="/dashboard/api-clients">
                        <div class="module-icon permission-icon">API</div>
                        <div class="module-card-heading"><h3>API clients</h3><span class="module-status">Available</span></div>
                        <p>Register integrations, assign least-privilege scopes, and rotate or revoke credentials.</p>
                        <div class="module-footer"><span>Integration security</span><span class="module-arrow" aria-hidden="true">↗</span></div>
                    </a>
                </section>
            }
            <footer class="dashboard-footer">ContentManagement <span>·</span> Workspace</footer>
        </main>
    </div>
}
else
{
    <div class="dashboard-loading">Your session has expired. Redirecting to sign in…</div>
}

@code {
    private bool _checkingSession = true;
    private bool _signedIn;
    private bool _isAdministrator;
    private bool _showWelcome;
    private bool _busy;
    private string _email = "";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        _showWelcome = Navigation.Uri.Contains("welcome=1", StringComparison.OrdinalIgnoreCase);
        try
        {
            using var response = await Http.GetAsync("api/auth/me");
            if (response.IsSuccessStatusCode)
            {
                var session = await response.Content.ReadFromJsonAsync<SessionResponse>();
                _email = session?.Email ?? "";
                _isAdministrator = string.Equals(session?.Role, "Administrator", StringComparison.Ordinal);
                _permissions = session?.Permissions ?? [];
                _signedIn = !string.IsNullOrWhiteSpace(_email);
            }
        }
        catch (HttpRequestException) { _message = "Unable to connect to the server."; }
        finally { _checkingSession = false; }

        if (!_signedIn && string.IsNullOrEmpty(_message))
            Navigation.NavigateTo("/", replace: true);
    }

    private async Task LogoutAsync()
    {
        if (_busy) return;
        _busy = true;
        _message = "";
        try
        {
            using var response = await Http.PostAsync("api/auth/logout", null);
            if (response.IsSuccessStatusCode)
                Navigation.NavigateTo("/", forceLoad: true, replace: true);
            else
                _message = "Unable to sign out. Please try again.";
        }
        catch (HttpRequestException) { _message = "Unable to connect to the server. Please try again."; }
        finally { _busy = false; }
    }

    private string[] _permissions = [];

    private bool CanAccessFiles => HasAnyPermission("files.read", "files.write", "files.delete");
    private bool CanAccessJson => HasAnyPermission("json.read", "json.write", "json.delete");
    private int VisibleModuleCount => (CanAccessFiles ? 1 : 0) + (CanAccessJson ? 1 : 0) + (_isAdministrator ? 3 : 0);

    private bool HasAnyPermission(params string[] requiredPermissions) =>
        _isAdministrator || _permissions.Any(permission =>
            requiredPermissions.Contains(permission, StringComparer.OrdinalIgnoreCase));

    private void DismissWelcome() { _showWelcome = false; Navigation.NavigateTo("/dashboard", replace: true); }

    private sealed record SessionResponse(string Email, string? Role, string[]? Permissions = null);
}
