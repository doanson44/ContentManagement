@page "/dashboard"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Dashboard · ContentManagement</PageTitle>

@if (_checkingSession)
{
    <div class="dashboard-loading">Checking administrator session…</div>
}
else if (_signedIn)
{
    <div class="dashboard-page">
        <aside class="dashboard-sidebar">
            <a class="dashboard-brand" href="/dashboard"><span class="dashboard-logo">CM</span><span>ContentManagement</span></a>
            <p class="sidebar-label">WORKSPACE</p>
            <a class="sidebar-link active" href="/dashboard"><span>⌂</span> Dashboard</a>
            <p class="sidebar-label">MANAGEMENT</p>
            @if (_isAdministrator)
            {
                <a class="sidebar-link" href="/dashboard/users"><span>♙</span> Users</a>
            }
            @if (_isAdministrator)
            {
                <div class="sidebar-link muted-link"><span>⌘</span> API clients <small>Planned</small></div>
            }
            @if (CanAccessFiles)
            {
                <div class="sidebar-link muted-link"><span>▤</span> Files <small>Planned</small></div>
            }
            @if (CanAccessJson)
            {
                <div class="sidebar-link muted-link"><span>{ }</span> JSON documents <small>Planned</small></div>
            }
            @if (_isAdministrator)
            {
                <p class="sidebar-label">SYSTEM</p>
                <a class="sidebar-link" href="/dashboard/setup"><span>⚙</span> Setup</a>
            }
            <div class="sidebar-bottom">
                <div class="admin-avatar">@(_isAdministrator ? "A" : "U")</div>
                <div class="admin-identity"><strong>@(_isAdministrator ? "Administrator" : "User")</strong><span>@_email</span></div>
                <button class="logout-button" title="Sign out" @onclick="LogoutAsync" disabled="@_busy">↗</button>
            </div>
        </aside>

        <main class="dashboard-main">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-eyebrow">WORKSPACE OVERVIEW</p>
                    <h1>Dashboard</h1>
                    <p class="dashboard-subtitle">Manage API access and your content from one place.</p>
                </div>
                <div class="session-pill"><span></span> @(_isAdministrator ? "Admin session active" : "User session active")</div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="dashboard-message">@_message</div>
            }
            @if (_showWelcome)
            {
                <div class="welcome-notice" role="status">
                    <div><strong>@(_registrationWelcome ? "Congratulations! Your account registration was successful." : "Welcome to ContentManagement!")</strong><span>@(_registrationWelcome ? "Your email is verified and your account is active. You can now access your workspace." : "Your account is ready. You can now access your workspace.")</span></div>
                    <button type="button" aria-label="Dismiss welcome message" @onclick="DismissWelcome">×</button>
                </div>
            }

            <section class="welcome-panel">
                <div>
                    <p class="welcome-kicker">CONTENT MANAGEMENT</p>
                    <h2>Welcome to your workspace</h2>
                    <p>Choose a management area to get started. The dashboard navigation is ready; management screens will be added incrementally.</p>
                </div>
                <div class="welcome-decoration" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            </section>

            <div class="section-heading">
                <div><h2>Management</h2><p>Core areas of your content platform</p></div>
                <span class="module-count">@VisibleModuleCount modules</span>
            </div>

            <section class="module-grid" aria-label="Management modules">
                @if (_isAdministrator)
                {
                <article class="module-card">
                    <div class="module-icon permission-icon">♙</div>
                    <div class="module-card-heading"><h3>User management</h3><span class="module-status">Available</span></div>
                    <p>Invite users, assign content permissions, and activate or disable accounts.</p>
                    <div class="module-footer"><span><a href="/dashboard/users">Manage users</a></span><span class="module-arrow">↗</span></div>
                </article>
                }
                @if (_isAdministrator)
                {
                    <article class="module-card">
                        <div class="module-icon api-icon">⌘</div>
                        <div class="module-card-heading"><h3>API clients</h3><span class="module-status">Planned</span></div>
                        <p>Register applications, configure client credentials, and rotate or revoke secrets.</p>
                        <div class="module-footer"><span>Client configuration</span><span class="module-arrow">↗</span></div>
                    </article>
                }
                @if (CanAccessFiles)
                {
                    <article class="module-card">
                        <div class="module-icon files-icon">▤</div>
                        <div class="module-card-heading"><h3>File management</h3><span class="module-status">Planned</span></div>
                        <p>Browse file metadata, inspect status, and manage stored binary content.</p>
                        <div class="module-footer"><span>Binary assets</span><span class="module-arrow">↗</span></div>
                    </article>
                }
                @if (CanAccessJson)
                {
                    <article class="module-card">
                        <div class="module-icon json-icon">{ }</div>
                        <div class="module-card-heading"><h3>JSON documents</h3><span class="module-status">Planned</span></div>
                        <p>Manage JSON documents and their metadata, validation, and lifecycle.</p>
                        <div class="module-footer"><span>Structured content</span><span class="module-arrow">↗</span></div>
                    </article>
                }
            </section>
            <footer class="dashboard-footer">ContentManagement <span>·</span> Administrator workspace</footer>
        </main>
    </div>
}
else
{
    <div class="dashboard-loading">Your session has expired. Redirecting to sign in…</div>
}

@code {
    private bool _checkingSession = true;
    private bool _signedIn;
    private bool _isAdministrator;
    private bool _showWelcome;
    private bool _registrationWelcome;
    private bool _busy;
    private HashSet<string> _permissions = new(StringComparer.Ordinal);
    private string _email = "";
    private string _message = "";

    protected override async Task OnInitializedAsync()
    {
        _showWelcome = Navigation.Uri.Contains("welcome=1", StringComparison.OrdinalIgnoreCase);
        _registrationWelcome = Navigation.Uri.Contains("welcome=registered", StringComparison.OrdinalIgnoreCase);
        try
        {
            using var response = await Http.GetAsync("api/auth/me");
            if (response.IsSuccessStatusCode)
            {
                var session = await response.Content.ReadFromJsonAsync<SessionResponse>();
                _email = session?.Email ?? "";
                _isAdministrator = string.Equals(session?.Role, "Administrator", StringComparison.Ordinal);
                _permissions = new HashSet<string>(session?.Permissions ?? [], StringComparer.Ordinal);
                _signedIn = !string.IsNullOrWhiteSpace(_email);
            }
        }
        catch (HttpRequestException) { _message = "Unable to connect to the server."; }
        finally { _checkingSession = false; }

        if (!_signedIn && string.IsNullOrEmpty(_message))
            Navigation.NavigateTo("/", replace: true);
    }

    private async Task LogoutAsync()
    {
        if (_busy) return;
        _busy = true;
        _message = "";
        try
        {
            using var response = await Http.PostAsync("api/auth/logout", null);
            if (response.IsSuccessStatusCode)
                Navigation.NavigateTo("/", forceLoad: true, replace: true);
            else
                _message = "Unable to sign out. Please try again.";
        }
        catch (HttpRequestException) { _message = "Unable to connect to the server. Please try again."; }
        finally { _busy = false; }
    }

    private bool CanAccessFiles => _isAdministrator || _permissions.Overlaps(["files.read", "files.write", "files.delete"]);
    private bool CanAccessJson => _isAdministrator || _permissions.Overlaps(["json.read", "json.write", "json.delete"]);
    private int VisibleModuleCount => (_isAdministrator ? 2 : 0) + (CanAccessFiles ? 1 : 0) + (CanAccessJson ? 1 : 0);

    private void DismissWelcome() { _showWelcome = false; Navigation.NavigateTo("/dashboard", replace: true); }

    private sealed record SessionResponse(string Email, string? Role, string[]? Permissions);
}
