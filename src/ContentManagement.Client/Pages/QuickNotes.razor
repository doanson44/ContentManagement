@page "/dashboard/quick-notes"
@using System.Net.Http.Json
@using System.Net
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Quick Notes · ContentManagement</PageTitle>

<div class="quick-notes-page">
    <header class="quick-notes-header">
        <div>
            <p class="quick-notes-eyebrow">PERSONAL WORKSPACE</p>
            <h1>Quick Notes</h1>
            <p class="quick-notes-subtitle">Capture ideas quickly. Changes are saved automatically.</p>
        </div>
        <button class="quick-notes-primary" type="button" @onclick="CreateNoteAsync" disabled="@_busy">New note</button>
    </header>

    @if (_loading)
    {
        <p class="quick-notes-state">Loading your notes…</p>
    }
    else if (!_signedIn)
    {
        <section class="quick-notes-state" role="alert">
            <p>@_error</p>
            <button type="button" @onclick="SignIn">Sign in</button>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="quick-notes-error" role="alert">@_error</div>
        }

        <div class="quick-notes-layout">
            <aside class="quick-notes-sidebar" aria-label="Notes list">
                <label class="quick-notes-search">
                    <span>Search notes</span>
                    <input type="search" @bind="_search" placeholder="Search title or content" />
                </label>

                @if (FilteredNotes.Count == 0)
                {
                    <div class="quick-notes-empty-list">
                        <strong>No notes found</strong>
                        <span>Create a note or try another search.</span>
                    </div>
                }
                else
                {
                    <div class="quick-notes-list">
                        @foreach (var note in FilteredNotes)
                        {
                            <button type="button"
                                    class="quick-notes-list-item @(note.Id == _selected?.Id ? "selected" : "")"
                                    @onclick="() => SelectNote(note.Id)">
                                <span class="quick-notes-list-title">@note.Title</span>
                                @if (note.IsPinned) { <span class="quick-notes-pin" aria-label="Pinned">Pinned</span> }
                                <span class="quick-notes-list-preview">@Preview(note.Content)</span>
                                <time datetime="@note.UpdatedUtc.ToString("O")">@note.UpdatedUtc.ToLocalTime().ToString("MMM d, HH:mm")</time>
                            </button>
                        }
                    </div>
                }
            </aside>

            <section class="quick-notes-editor" aria-label="Note editor">
                @if (_selected is null)
                {
                    <div class="quick-notes-editor-empty">
                        <h2>Your notes, in one place</h2>
                        <p>Create a note to capture an idea, reminder, or piece of information.</p>
                        <button class="quick-notes-primary" type="button" @onclick="CreateNoteAsync" disabled="@_busy">Create your first note</button>
                    </div>
                }
                else
                {
                    <div class="quick-notes-editor-toolbar">
                        <span class="quick-notes-save-status" role="status">@_saveStatus</span>
                        <div class="quick-notes-actions">
                            <button type="button" class="quick-notes-secondary" @onclick="TogglePinAsync">
                                @(_selected.IsPinned ? "Unpin" : "Pin")
                            </button>
                            <button type="button" class="quick-notes-danger" @onclick="DeleteSelectedAsync">Delete</button>
                        </div>
                    </div>
                    <label class="quick-notes-title-label" for="quick-note-title">Title</label>
                    <input id="quick-note-title" class="quick-notes-title-input" maxlength="200"
                           @bind="_selected.Title" @bind:event="oninput" @bind:after="ScheduleSave" />
                    <label class="quick-notes-content-label" for="quick-note-content">Note</label>
                    <textarea id="quick-note-content" class="quick-notes-content-input" maxlength="20000"
                              placeholder="Start writing…" @bind="_selected.Content"
                              @bind:event="oninput" @bind:after="ScheduleSave"></textarea>
                    <footer class="quick-notes-editor-footer">
                        <span>Plain text · Up to 20,000 characters</span>
                        <span>@_selected.Content.Length.ToString("N0") / 20,000</span>
                    </footer>
                }
            </section>
        </div>
    }
</div>

<style>
    .quick-notes-page { max-width: 1240px; margin: 0 auto; padding: 32px; color: var(--text-primary, #172033); }
    .quick-notes-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
    .quick-notes-eyebrow { margin: 0 0 8px; color: #64748b; font-size: .75rem; font-weight: 700; letter-spacing: .12em; }
    .quick-notes-header h1 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.4rem); }
    .quick-notes-subtitle { margin: 8px 0 0; color: #64748b; }
    .quick-notes-primary, .quick-notes-secondary, .quick-notes-danger { border: 1px solid #cbd5e1; border-radius: 9px; padding: 10px 14px; background: white; color: #172033; font: inherit; cursor: pointer; }
    .quick-notes-primary { background: #1e293b; border-color: #1e293b; color: white; }
    .quick-notes-primary:disabled { opacity: .55; cursor: wait; }
    .quick-notes-layout { display: grid; grid-template-columns: minmax(250px, 330px) minmax(0, 1fr); min-height: 560px; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; background: white; }
    .quick-notes-sidebar { padding: 18px; border-right: 1px solid #e2e8f0; background: #f8fafc; }
    .quick-notes-search { display: grid; gap: 8px; color: #64748b; font-size: .8rem; font-weight: 600; }
    .quick-notes-search input, .quick-notes-title-input { box-sizing: border-box; width: 100%; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px 12px; background: white; font: inherit; color: #172033; }
    .quick-notes-list { display: grid; gap: 8px; margin-top: 18px; }
    .quick-notes-list-item { display: grid; gap: 7px; width: 100%; text-align: left; border: 1px solid transparent; border-radius: 10px; padding: 12px; background: transparent; cursor: pointer; color: #172033; }
    .quick-notes-list-item.selected { background: white; border-color: #cbd5e1; box-shadow: 0 1px 2px #0f172a0a; }
    .quick-notes-list-title { overflow-wrap: anywhere; font-weight: 700; }
    .quick-notes-list-preview { overflow-wrap: anywhere; color: #64748b; font-size: .85rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .quick-notes-list-item time { color: #94a3b8; font-size: .75rem; }
    .quick-notes-pin { justify-self: start; border-radius: 99px; padding: 2px 7px; background: #e2e8f0; color: #475569; font-size: .7rem; }
    .quick-notes-editor { display: flex; flex-direction: column; padding: 24px; min-width: 0; }
    .quick-notes-editor-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 28px; }
    .quick-notes-save-status { color: #64748b; font-size: .85rem; }
    .quick-notes-actions { display: flex; gap: 8px; }
    .quick-notes-danger { color: #b91c1c; }
    .quick-notes-title-label, .quick-notes-content-label { margin: 0 0 8px; color: #64748b; font-size: .8rem; font-weight: 600; }
    .quick-notes-title-input { margin-bottom: 22px; border-color: transparent; padding: 4px 0; font-size: 1.5rem; font-weight: 700; }
    .quick-notes-title-input:focus { outline: none; border-color: #cbd5e1; padding-left: 8px; }
    .quick-notes-content-input { flex: 1; width: 100%; min-height: 330px; resize: vertical; box-sizing: border-box; border: 1px solid transparent; border-radius: 8px; padding: 8px 0; font: inherit; line-height: 1.7; color: #172033; }
    .quick-notes-content-input:focus { outline: none; border-color: #cbd5e1; padding: 8px; }
    .quick-notes-editor-footer { display: flex; justify-content: space-between; gap: 12px; margin-top: 14px; color: #94a3b8; font-size: .75rem; }
    .quick-notes-state, .quick-notes-empty-list, .quick-notes-editor-empty { padding: 32px; color: #64748b; text-align: center; }
    .quick-notes-empty-list { display: grid; gap: 8px; }
    .quick-notes-editor-empty { display: grid; align-content: center; justify-items: center; flex: 1; }
    .quick-notes-editor-empty h2 { color: #172033; }
    .quick-notes-error { margin-bottom: 16px; border: 1px solid #fecaca; border-radius: 8px; padding: 12px; background: #fef2f2; color: #991b1b; }
    @@media (max-width: 760px) { .quick-notes-page { padding: 18px; } .quick-notes-header { align-items: flex-start; } .quick-notes-layout { grid-template-columns: 1fr; } .quick-notes-sidebar { border-right: 0; border-bottom: 1px solid #e2e8f0; } .quick-notes-list { max-height: 240px; overflow: auto; } .quick-notes-editor { padding: 18px; } }
</style>

@code {
    private readonly SemaphoreSlim _saveGate = new(1, 1);
    private CancellationTokenSource? _saveDelay;
    private List<QuickNoteItem> _notes = [];
    private QuickNoteItem? _selected;
    private string _search = string.Empty;
    private string _error = string.Empty;
    private string _saveStatus = "Changes save automatically";
    private bool _loading = true;
    private bool _signedIn;
    private bool _busy;
    private bool _disposed;

    private List<QuickNoteItem> FilteredNotes => _notes
        .Where(note => string.IsNullOrWhiteSpace(_search)
            || note.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || note.Content.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(note => note.IsPinned)
        .ThenByDescending(note => note.UpdatedUtc)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var session = await Http.GetAsync("api/auth/me");
            if (!session.IsSuccessStatusCode)
            {
                _error = "Your administrator session has expired.";
                return;
            }

            _signedIn = true;
            _notes = await Http.GetFromJsonAsync<List<QuickNoteItem>>("api/admin/quick-notes") ?? [];
            _selected = _notes.FirstOrDefault();
        }
        catch (HttpRequestException)
        {
            _error = "Unable to load notes. Check your connection and try again.";
        }
        catch (NotSupportedException)
        {
            _error = "The server returned an unexpected response while loading notes.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SignIn() => Navigation.NavigateTo("/", replace: true);

    private async Task CreateNoteAsync()
    {
        if (_busy || !_signedIn) return;
        _busy = true;
        _error = string.Empty;
        try
        {
            var request = new SaveQuickNoteRequest("Untitled note", string.Empty, false, null);
            using var response = await Http.PostAsJsonAsync("api/admin/quick-notes", request);
            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadErrorAsync(response);
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<QuickNoteItem>();
            if (created is null)
            {
                _error = "The server created the note but returned no note data.";
                return;
            }

            _notes.Insert(0, created);
            _selected = created;
            _search = string.Empty;
            _saveStatus = "Saved";
        }
        catch (HttpRequestException)
        {
            _error = "Unable to create a note. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void SelectNote(Guid id)
    {
        CancelPendingSave();
        _selected = _notes.FirstOrDefault(note => note.Id == id);
        _saveStatus = "Changes save automatically";
        _error = string.Empty;
    }

    private void ScheduleSave()
    {
        if (_selected is null || _disposed) return;
        _saveDelay?.Cancel();
        _saveDelay?.Dispose();
        _saveDelay = new CancellationTokenSource();
        var token = _saveDelay.Token;
        _saveStatus = "Unsaved changes";
        _ = SaveAfterDelayAsync(token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(650, token);
            await SaveSelectedAsync(token);
        }
        catch (OperationCanceledException) { }
    }

    private async Task SaveSelectedAsync(CancellationToken cancellationToken)
    {
        await _saveGate.WaitAsync(cancellationToken);
        try
        {
            var note = _selected;
            if (note is null || _disposed) return;

            var savedTitle = note.Title;
            var savedContent = note.Content;
            var savedPinned = note.IsPinned;
            _saveStatus = "Saving…";
            _error = string.Empty;

            using var response = await Http.PutAsJsonAsync(
                $"api/admin/quick-notes/{note.Id}",
                new SaveQuickNoteRequest(savedTitle, savedContent, savedPinned, note.RowVersion),
                cancellationToken);

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                _saveStatus = "Save conflict";
                _error = "This note changed on the server. Reload the page before continuing to avoid overwriting newer content.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _saveStatus = "Save failed";
                _error = await ReadErrorAsync(response);
                return;
            }

            var saved = await response.Content.ReadFromJsonAsync<QuickNoteItem>(cancellationToken: cancellationToken);
            if (saved is null)
            {
                _saveStatus = "Save failed";
                _error = "The server saved the note but returned no confirmation.";
                return;
            }

            note.RowVersion = saved.RowVersion;
            note.UpdatedUtc = saved.UpdatedUtc;
            _saveStatus = note.Title == savedTitle && note.Content == savedContent && note.IsPinned == savedPinned
                ? "All changes saved"
                : "Unsaved changes";

            if (note.Title != savedTitle || note.Content != savedContent || note.IsPinned != savedPinned)
                ScheduleSave();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (HttpRequestException)
        {
            _saveStatus = "Save failed";
            _error = "Unable to save changes. Your edits remain in the editor; retry by editing the note again.";
        }
        finally
        {
            _saveGate.Release();
        }
    }

    private async Task TogglePinAsync()
    {
        if (_selected is null) return;
        _selected.IsPinned = !_selected.IsPinned;
        ScheduleSave();
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected is null) return;
        var note = _selected;
        CancelPendingSave();
        _error = string.Empty;
        try
        {
            using var response = await Http.DeleteAsync($"api/admin/quick-notes/{note.Id}");
            if (!response.IsSuccessStatusCode && response.StatusCode != HttpStatusCode.NotFound)
            {
                _error = await ReadErrorAsync(response);
                return;
            }

            _notes.RemoveAll(item => item.Id == note.Id);
            _selected = FilteredNotes.FirstOrDefault();
            _saveStatus = "Changes save automatically";
        }
        catch (HttpRequestException)
        {
            _error = "Unable to delete this note. Please try again.";
        }
    }

    private void CancelPendingSave()
    {
        _saveDelay?.Cancel();
        _saveDelay?.Dispose();
        _saveDelay = null;
    }

    private static string Preview(string content)
    {
        var normalized = content.Replace("\r", " ").Replace("\n", " ").Trim();
        return normalized.Length > 120 ? normalized[..120] : normalized;
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var problem = await response.Content.ReadFromJsonAsync<ApiError>();
            return problem?.Message ?? $"Request failed (HTTP {(int)response.StatusCode}).";
        }
        catch (Exception exception) when (exception is HttpRequestException or NotSupportedException or System.Text.Json.JsonException)
        {
            return $"Request failed (HTTP {(int)response.StatusCode}).";
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelPendingSave();
        return ValueTask.CompletedTask;
    }

    private sealed class QuickNoteItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "Untitled note";
        public string Content { get; set; } = string.Empty;
        public bool IsPinned { get; set; }
        public DateTime CreatedUtc { get; set; }
        public DateTime UpdatedUtc { get; set; }
        public string RowVersion { get; set; } = string.Empty;
    }

    private sealed record SaveQuickNoteRequest(string Title, string Content, bool IsPinned, string? RowVersion);
    private sealed record ApiError(string? Message);
}
