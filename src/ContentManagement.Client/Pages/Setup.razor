@page "/dashboard/setup"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Setup · ContentManagement</PageTitle>

@if (_loading)
{
    <div class="dashboard-loading">Loading setup…</div>
}
else if (_signedIn)
{
    <div class="dashboard-page dashboard-page-no-sidebar">
        <main class="dashboard-main setup-main">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-eyebrow">SYSTEM CONFIGURATION</p>
                    <h1>Setup</h1>
                    <p class="dashboard-subtitle">Configure how long files remain marked for deletion before permanent cleanup.</p>
                </div>
                <div class="session-pill"><span></span> Session active</div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="setup-notice @(_isError ? "error" : "success")" role="status">@_message</div>
            }

            <section class="setup-card">
                <div class="setup-section-heading">
                    <div class="setup-section-icon cleanup-setup-icon">⌫</div>
                    <div>
                        <h2>Stale file cleanup</h2>
                        <p>Files marked for deletion are permanently removed after the configured number of days.</p>
                    </div>
                </div>
                <p><strong>File age threshold:</strong> @_model.StaleFileAgeDays days</p>
                <p>Age is counted from when a file was marked for deletion. The cleanup job runs daily.</p>
                <div class="cleanup-warning">
                    <strong>Scheduled cleanup</strong>
                    <span>The daily background job removes eligible files marked for deletion. Saving this setting does not delete files immediately.</span>
                </div>
                <div class="setup-actions">
                    <button class="setup-primary" @onclick="() => _editOpen = true" disabled="@_busy">Edit settings</button>
                </div>
            </section>
            <section class="setup-card external-storage-setup">
                <div class="setup-section-heading">
                    <div class="setup-section-icon">⇧</div>
                    <div>
                        <h2>External File API storage</h2>
                        <p>Prefer the standalone ContentManagement.FileApi while quota is available. Files fall back to local storage only when the configured quota cannot fit the upload.</p>
                    </div>
                </div>
                <div class="setup-form-grid">
                    <label>External API base URL
                        <input type="url" @bind="_model.ExternalStorageBaseUrl" placeholder="https://files.example.com" disabled="@_busy" />
                        <small>Use the API root URL, without /api/files. HTTPS is required outside localhost.</small>
                    </label>
                    <label>External API key
                        <input type="password" @bind="_model.ExternalStorageApiKey" autocomplete="new-password" placeholder="@(_model.ExternalStorageApiKeyConfigured ? "Configured — leave blank to keep current key" : "Enter API key")" disabled="@_busy" />
                        <small>The key is encrypted at rest and is never returned to the browser.</small>
                    </label>
                    <label>External quota (GB)
                        <input type="number" min="0" step="0.1" @bind="_model.ExternalStorageQuotaGb" disabled="@_busy" />
                        <small>Quota is managed by this application, not queried from the External API.</small>
                    </label>
                    <label class="external-preference">
                        <span>Prefer External API</span>
                        <input type="checkbox" @bind="_model.ExternalStoragePreferred" disabled="@_busy" />
                        <small>When disabled or quota is insufficient, new files are stored locally.</small>
                    </label>
                </div>
                <div class="external-storage-usage">
                    <div><span>Quota</span><strong>@FormatBytes(_model.ExternalStorageQuotaBytes)</strong></div>
                    <div><span>Used by this system</span><strong>@FormatBytes(_model.ExternalStorageUsedBytes)</strong></div>
                    <div><span>Remaining</span><strong>@FormatBytes(_model.ExternalStorageRemainingBytes)</strong></div>
                </div>
                <div class="setup-actions">
                    <button class="setup-primary" @onclick="SaveAsync" disabled="@_busy">Save setup</button>
                </div>
            </section>
            @if (_editOpen)
            {
                <div class="cm-modal-backdrop" role="presentation" @onclick="CloseEdit">
                    <section class="setup-card cm-modal" role="dialog" aria-modal="true" aria-labelledby="cleanup-edit-title" @onclick:stopPropagation="true">
                        <h2 id="cleanup-edit-title">Edit cleanup settings</h2>
                        <div class="setup-form-grid cleanup-grid">
                            <label>File age threshold (days)
                                <input type="number" min="1" max="3650" @bind="_model.StaleFileAgeDays" disabled="@_busy" />
                                <small>Choose between 1 and 3650 days.</small>
                            </label>
                        </div>
                        <div class="setup-actions">
                            <button class="files-secondary" @onclick="CloseEdit" disabled="@_busy">Cancel</button>
                            <button class="setup-primary" @onclick="SaveAsync" disabled="@_busy">Save settings</button>
                        </div>
                    </section>
                </div>
            }
            <footer class="dashboard-footer">ContentManagement <span>·</span> System setup</footer>
        </main>
    </div>
}
else
{
    <div class="dashboard-loading">Your session has expired. Redirecting to sign in…</div>
}

@code {
    private bool _loading = true;
    private bool _signedIn;
    private bool _busy;
    private bool _editOpen;
    private bool _isError;
    private string _email = "";
    private string _message = "";
    private SetupModel _model = new();
    private int _savedStaleFileAgeDays = 90;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var sessionResponse = await Http.GetAsync("api/auth/me");
            if (!sessionResponse.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<SessionResponse>();
            _email = session?.Email ?? "";
            _signedIn = !string.IsNullOrWhiteSpace(_email);
            if (!string.Equals(session?.Role, "Administrator", StringComparison.Ordinal))
            {
                Navigation.NavigateTo("/dashboard", replace: true);
                return;
            }
            if (!_signedIn)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            using var response = await Http.GetAsync("api/admin/setup");
            if (!response.IsSuccessStatusCode)
            {
                SetMessage("Unable to load cleanup settings.", true);
                return;
            }

            var settings = await response.Content.ReadFromJsonAsync<SetupResponse>();
            if (settings is not null)
            {
                _savedStaleFileAgeDays = settings.StaleFileAgeDays;
                _model = new SetupModel
                {
                    StaleFileAgeDays = _savedStaleFileAgeDays,
                    ExternalStorageBaseUrl = settings.ExternalStorageBaseUrl ?? "",
                    ExternalStorageApiKeyConfigured = settings.ExternalStorageApiKeyConfigured,
                    ExternalStorageQuotaBytes = settings.ExternalStorageQuotaBytes,
                    ExternalStorageQuotaGb = settings.ExternalStorageQuotaBytes / (1024d * 1024 * 1024),
                    ExternalStorageUsedBytes = settings.ExternalStorageUsedBytes,
                    ExternalStorageRemainingBytes = settings.ExternalStorageRemainingBytes,
                    ExternalStoragePreferred = settings.ExternalStoragePreferred
                };
            }
        }
        catch (HttpRequestException) { SetMessage("Unable to connect to the server.", true); }
        finally { _loading = false; }
    }

    private void CloseEdit()
    {
        if (_busy) return;
        _model.StaleFileAgeDays = _savedStaleFileAgeDays;
        _editOpen = false;
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (_model.StaleFileAgeDays is < 1 or > 3650)
        {
            SetMessage("File age threshold must be between 1 and 3650 days.", true);
            return;
        }
        if (!double.IsFinite(_model.ExternalStorageQuotaGb) ||
            _model.ExternalStorageQuotaGb < 0 || _model.ExternalStorageQuotaGb > 1_000_000)
        {
            SetMessage("External quota must be between 0 and 1,000,000 GB.", true);
            return;
        }

        _busy = true;
        _message = "";
        try
        {
            using var response = await Http.PutAsJsonAsync("api/admin/setup", new
            {
                StaleFileAgeDays = _model.StaleFileAgeDays,
                ExternalStorageBaseUrl = _model.ExternalStorageBaseUrl,
                ExternalStorageApiKey = _model.ExternalStorageApiKey,
                ExternalStorageQuotaBytes = checked((long)Math.Round(_model.ExternalStorageQuotaGb * 1024d * 1024 * 1024)),
                ExternalStoragePreferred = _model.ExternalStoragePreferred
            });
            if (!response.IsSuccessStatusCode)
            {
                var problem = await response.Content.ReadFromJsonAsync<ApiMessage>();
                SetMessage(problem?.Message ?? "Unable to save cleanup settings.", true);
                return;
            }

            _savedStaleFileAgeDays = _model.StaleFileAgeDays;
            var saved = await response.Content.ReadFromJsonAsync<SetupResponse>();
            if (saved is not null)
            {
                _model.ExternalStorageApiKeyConfigured = saved.ExternalStorageApiKeyConfigured;
                _model.ExternalStorageQuotaBytes = saved.ExternalStorageQuotaBytes;
                _model.ExternalStorageQuotaGb = saved.ExternalStorageQuotaBytes / (1024d * 1024 * 1024);
                _model.ExternalStorageUsedBytes = saved.ExternalStorageUsedBytes;
                _model.ExternalStorageRemainingBytes = saved.ExternalStorageRemainingBytes;
                _model.ExternalStorageApiKey = "";
            }
            SetMessage("Setup settings saved.", false);
            _editOpen = false;
        }
        catch (HttpRequestException) { SetMessage("Unable to connect to the server.", true); }
        finally { _busy = false; }
    }

    private void SetMessage(string message, bool error) { _message = message; _isError = error; }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double size = Math.Max(0, bytes);
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1) { size /= 1024; unit++; }
        return $"{size:0.##} {units[unit]}";
    }

    private sealed class SetupModel
    {
        public int StaleFileAgeDays { get; set; } = 90;
        public string ExternalStorageBaseUrl { get; set; } = "";
        public string ExternalStorageApiKey { get; set; } = "";
        public bool ExternalStorageApiKeyConfigured { get; set; }
        public double ExternalStorageQuotaGb { get; set; } = 10;
        public long ExternalStorageQuotaBytes { get; set; } = 10L * 1024 * 1024 * 1024;
        public long ExternalStorageUsedBytes { get; set; }
        public long ExternalStorageRemainingBytes { get; set; }
        public bool ExternalStoragePreferred { get; set; }
    }

    private sealed record SessionResponse(string Email, string? Role);
    private sealed record SetupResponse(int StaleFileAgeDays, string ExternalStorageBaseUrl,
        bool ExternalStorageApiKeyConfigured, long ExternalStorageQuotaBytes,
        long ExternalStorageUsedBytes, long ExternalStorageRemainingBytes, bool ExternalStoragePreferred);
    private sealed record ApiMessage(string? Message);
}
