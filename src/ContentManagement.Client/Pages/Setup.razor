@page "/dashboard/setup"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Setup · ContentManagement</PageTitle>

@if (_loading)
{
    <div class="dashboard-loading">Loading setup…</div>
}
else if (_signedIn)
{
    <div class="dashboard-page dashboard-page-no-sidebar">
        <main class="dashboard-main setup-main">
            <header class="dashboard-header">
                <div>
                    <p class="dashboard-eyebrow">SYSTEM CONFIGURATION</p>
                    <h1>Setup</h1>
                    <p class="dashboard-subtitle">Configure how long files remain marked for deletion before permanent cleanup.</p>
                </div>
                <div class="session-pill"><span></span> Session active</div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="setup-notice @(_isError ? "error" : "success")" role="status">@_message</div>
            }

            <section class="setup-card">
                <div class="setup-section-heading">
                    <div class="setup-section-icon cleanup-setup-icon">⌫</div>
                    <div>
                        <h2>Stale file cleanup</h2>
                        <p>Files marked for deletion are permanently removed after the configured number of days.</p>
                    </div>
                </div>
                <p><strong>File age threshold:</strong> @_model.StaleFileAgeDays days</p>
                <p>Age is counted from when a file was marked for deletion. The cleanup job runs daily.</p>
                <div class="cleanup-warning">
                    <strong>Scheduled cleanup</strong>
                    <span>The daily background job removes eligible files marked for deletion. Saving this setting does not delete files immediately.</span>
                </div>
                <div class="setup-actions">
                    <button class="setup-primary" @onclick="() => _editOpen = true" disabled="@_busy">Edit settings</button>
                </div>
            </section>
            @if (_editOpen)
            {
                <div class="cm-modal-backdrop" role="presentation" @onclick="CloseEdit">
                    <section class="setup-card cm-modal" role="dialog" aria-modal="true" aria-labelledby="cleanup-edit-title" @onclick:stopPropagation="true">
                        <h2 id="cleanup-edit-title">Edit cleanup settings</h2>
                        <div class="setup-form-grid cleanup-grid">
                            <label>File age threshold (days)
                                <input type="number" min="1" max="3650" @bind="_model.StaleFileAgeDays" disabled="@_busy" />
                                <small>Choose between 1 and 3650 days.</small>
                            </label>
                        </div>
                        <div class="setup-actions">
                            <button class="files-secondary" @onclick="CloseEdit" disabled="@_busy">Cancel</button>
                            <button class="setup-primary" @onclick="SaveAsync" disabled="@_busy">Save settings</button>
                        </div>
                    </section>
                </div>
            }
            <footer class="dashboard-footer">ContentManagement <span>·</span> System setup</footer>
        </main>
    </div>
}
else
{
    <div class="dashboard-loading">Your session has expired. Redirecting to sign in…</div>
}

@code {
    private bool _loading = true;
    private bool _signedIn;
    private bool _busy;
    private bool _editOpen;
    private bool _isError;
    private string _email = "";
    private string _message = "";
    private SetupModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var sessionResponse = await Http.GetAsync("api/auth/me");
            if (!sessionResponse.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<SessionResponse>();
            _email = session?.Email ?? "";
            _signedIn = !string.IsNullOrWhiteSpace(_email);
            if (!string.Equals(session?.Role, "Administrator", StringComparison.Ordinal))
            {
                Navigation.NavigateTo("/dashboard", replace: true);
                return;
            }
            if (!_signedIn)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            using var response = await Http.GetAsync("api/admin/setup");
            if (!response.IsSuccessStatusCode)
            {
                SetMessage("Unable to load cleanup settings.", true);
                return;
            }

            var settings = await response.Content.ReadFromJsonAsync<SetupResponse>();
            if (settings is not null)
                _model = new SetupModel { StaleFileAgeDays = settings.StaleFileAgeDays };
        }
        catch (HttpRequestException) { SetMessage("Unable to connect to the server.", true); }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        if (_model.StaleFileAgeDays is < 1 or > 3650)
        {
            SetMessage("File age threshold must be between 1 and 3650 days.", true);
            return;
        }

        _busy = true;
        _message = "";
        try
        {
            using var response = await Http.PutAsJsonAsync("api/admin/setup", _model);
            if (!response.IsSuccessStatusCode)
            {
                var problem = await response.Content.ReadFromJsonAsync<ApiMessage>();
                SetMessage(problem?.Message ?? "Unable to save cleanup settings.", true);
                return;
            }

            SetMessage("Cleanup settings saved.", false);
            _editOpen = false;
        }
        catch (HttpRequestException) { SetMessage("Unable to connect to the server.", true); }
        finally { _busy = false; }
    }

    private void SetMessage(string message, bool error) { _message = message; _isError = error; }

    private sealed class SetupModel
    {
        public int StaleFileAgeDays { get; set; } = 90;
    }

    private sealed record SessionResponse(string Email, string? Role);
    private sealed record SetupResponse(int StaleFileAgeDays);
    private sealed record ApiMessage(string? Message);
}
