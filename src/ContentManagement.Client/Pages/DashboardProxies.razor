@page "/dashboard/proxies"
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Proxy Management · ContentManagement</PageTitle>

<div class="proxy-page">
    <header class="proxy-header">
        <div>
            <a class="proxy-back-link" href="/dashboard">← Dashboard</a>
            <p class="dashboard-eyebrow">ADMINISTRATION</p>
            <h1>Proxy Management</h1>
            <p class="dashboard-subtitle">Browse the public Vietnam proxy list supplied by ProxyScrape.</p>
        </div>
        <button class="proxy-refresh-button" type="button" @onclick="LoadProxiesAsync" disabled="@_loading">
            @if (_loading) { <span>Loading…</span> } else { <span>↻ Refresh list</span> }
        </button>
    </header>

    <section class="proxy-notice" role="note">
        <strong>Public proxies are untrusted.</strong>
        <span>Availability and ownership can change at any time. Do not send credentials, personal data, or other sensitive content through these endpoints.</span>
    </section>

    <section class="proxy-pinned-panel" aria-live="polite">
        <div><span class="proxy-pinned-label">Currently pinned proxy</span>
            @if (_pinnedProxy is null) { <strong>No proxy pinned</strong><small>Pin one proxy to enable automatic health monitoring.</small> }
            else { <strong>@_pinnedProxy.Address</strong><small>@(_pinnedProxy.IsHealthy is null ? "Health not checked yet" : _pinnedProxy.IsHealthy == true ? $"TCP reachable · {_pinnedProxy.LatencyMilliseconds} ms" : "Unreachable") · pinned @_pinnedProxy.PinnedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small> }
        </div>
        <button type="button" @onclick="LoadPinnedAsync">Refresh pinned status</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="proxy-error" role="alert">
            <span>@_error</span>
            <button type="button" @onclick="LoadProxiesAsync" disabled="@_loading">Try again</button>
        </div>
    }

    <section class="proxy-summary-grid" aria-label="Proxy list summary">
        <article class="proxy-summary-card"><span>Fetched proxies</span><strong>@_proxies.Count</strong></article>
        <article class="proxy-summary-card"><span>Matching filters</span><strong>@FilteredProxies.Count()</strong></article>
        <article class="proxy-summary-card"><span>Protocols</span><strong>@FilteredProtocolsCount</strong></article>
    </section>

    <section class="proxy-list-panel">
        <div class="proxy-list-heading">
            <div><h2>Vietnam proxy list</h2><p>@(_fetchedAt is null ? "Not loaded yet" : $"Last fetched: {_fetchedAt.Value.ToLocalTime():yyyy-MM-dd HH:mm:ss}")</p></div>
            <button type="button" class="proxy-copy-all-button" @onclick="CopyFilteredAsync" disabled="@(FilteredProxies.Count() == 0)">Copy filtered list</button>
        </div>

        <div class="proxy-filters">
            <label>
                <span>Search address</span>
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="Search IP or port" @bind:after="ResetPage" />
            </label>
            <label>
                <span>Protocol</span>
                <select @bind="_protocol" @bind:after="ResetPage">
                    <option value="">All protocols</option>
                    <option value="http">HTTP</option>
                    <option value="https">HTTPS</option>
                    <option value="socks4">SOCKS4</option>
                    <option value="socks5">SOCKS5</option>
                </select>
            </label>
            <label>
                <span>Rows per page</span>
                <select @bind="_pageSize" @bind:after="ResetPage">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>

        @if (_loading && _proxies.Count == 0)
        {
            <div class="proxy-empty-state">Loading proxy list…</div>
        }
        else if (!_loading && _proxies.Count == 0 && string.IsNullOrWhiteSpace(_error))
        {
            <div class="proxy-empty-state">No Vietnam proxies were returned by ProxyScrape. Try refreshing later.</div>
        }
        else if (FilteredProxies.Count() == 0 && string.IsNullOrWhiteSpace(_error))
        {
            <div class="proxy-empty-state">No proxies match the current filters.</div>
        }
        else
        {
            <div class="proxy-table-wrap">
                <table class="proxy-table">
                    <thead><tr><th>Protocol</th><th>Proxy address</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var proxy in PagedProxies)
                        {
                            <tr @key="proxy.Address">
                                <td><span class="proxy-protocol-badge">@proxy.Protocol.ToUpperInvariant()</span></td>
                                <td><code>@proxy.Address</code></td>
                                <td class="proxy-row-actions"><button class="proxy-copy-button" type="button" @onclick="() => CopyOneAsync(proxy.Address)">Copy</button><button class="proxy-pin-button" type="button" @onclick="() => PinProxyAsync(proxy)" disabled="@(_pinning || string.Equals(_pinnedProxy?.Address, proxy.Address, StringComparison.OrdinalIgnoreCase))">@(string.Equals(_pinnedProxy?.Address, proxy.Address, StringComparison.OrdinalIgnoreCase) ? "Pinned" : "Pin proxy")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer class="proxy-pagination">
                <span>Showing @ShowingStart–@ShowingEnd of @FilteredProxies.Count() proxies</span>
                <div>
                    <button type="button" @onclick="PreviousPage" disabled="@(_page <= 1)">Previous</button>
                    <span>Page @_page of @TotalPages</span>
                    <button type="button" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                </div>
            </footer>
        }
    </section>
    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <p class="proxy-feedback" role="status">@_feedback</p>
    }
</div>

@code {
    private List<ProxyEntry> _proxies = [];
    private bool _loading;
    private string _error = "";
    private string _feedback = "";
    private string _search = "";
    private string _protocol = "";
    private int _page = 1;
    private int _pageSize = 20;
    private DateTimeOffset? _fetchedAt;
    private PinnedProxyResponse? _pinnedProxy;
    private bool _pinning;

    private IEnumerable<ProxyEntry> FilteredProxies => _proxies
        .Where(proxy => string.IsNullOrWhiteSpace(_protocol) || proxy.Protocol.Equals(_protocol, StringComparison.OrdinalIgnoreCase))
        .Where(proxy => string.IsNullOrWhiteSpace(_search) || proxy.Address.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderBy(proxy => proxy.Protocol, StringComparer.OrdinalIgnoreCase)
        .ThenBy(proxy => proxy.Address, StringComparer.OrdinalIgnoreCase);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredProxies.Count() / (double)_pageSize));
    private IEnumerable<ProxyEntry> PagedProxies => FilteredProxies.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int ShowingStart => FilteredProxies.Count() == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int ShowingEnd => Math.Min(_page * _pageSize, FilteredProxies.Count());
    private int FilteredProtocolsCount => FilteredProxies.Select(proxy => proxy.Protocol).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var sessionResponse = await Http.GetAsync("api/auth/me");
            if (!sessionResponse.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<SessionResponse>();
            if (!string.Equals(session?.Role, "Administrator", StringComparison.Ordinal))
            {
                Navigation.NavigateTo("/dashboard", replace: true);
                return;
            }
        }
        catch (HttpRequestException)
        {
            _error = "Unable to connect to the server.";
            return;
        }

        await LoadProxiesAsync();
    }

    private async Task LoadProxiesAsync()
    {
        if (_loading) return;
        _loading = true;
        _error = "";
        _feedback = "";
        try
        {
            using var response = await Http.GetAsync("api/proxies");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo("/dashboard", replace: true);
                return;
            }

            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<ProxyListResponse>();
            _proxies = result?.Proxies ?? [];
            _fetchedAt = result?.FetchedAt;
            _page = Math.Min(_page, TotalPages);
            await LoadPinnedAsync();
        }
        catch (HttpRequestException)
        {
            _error = "Unable to retrieve the proxy list. The upstream service may be unavailable; try again shortly.";
        }
        catch (System.Text.Json.JsonException)
        {
            _error = "The proxy API returned an unexpected response. Try again later.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPinnedAsync()
    {
        try
        {
            _pinnedProxy = await Http.GetFromJsonAsync<PinnedProxyResponse>("api/proxies/pinned");
        }
        catch (HttpRequestException)
        {
            _feedback = "Unable to retrieve the currently pinned proxy.";
        }
    }

    private async Task PinProxyAsync(ProxyEntry proxy)
    {
        if (_pinning) return;
        _pinning = true;
        _feedback = "";
        try
        {
            using var response = await Http.PostAsJsonAsync("api/proxies/pin", new { Address = proxy.Address });
            if (!response.IsSuccessStatusCode)
            {
                _feedback = "Unable to pin this proxy. Refresh the list and try again.";
                return;
            }

            _pinnedProxy = await response.Content.ReadFromJsonAsync<PinnedProxyResponse>();
            _feedback = $"Pinned {proxy.Address}. The previous proxy was unpinned.";
        }
        catch (HttpRequestException)
        {
            _feedback = "Unable to connect to the server to pin this proxy.";
        }
        finally
        {
            _pinning = false;
        }
    }

    private async Task CopyOneAsync(string address)
    {
        var copied = await JS.InvokeAsync<bool>("contentManagementFiles.copyText", address);
        _feedback = copied ? $"Copied {address}" : "Copy failed. Check browser clipboard permissions.";
    }

    private async Task CopyFilteredAsync()
    {
        var text = string.Join(Environment.NewLine, FilteredProxies.Select(proxy => proxy.Address));
        if (text.Length == 0) return;
        var copied = await JS.InvokeAsync<bool>("contentManagementFiles.copyText", text);
        _feedback = copied ? $"Copied {FilteredProxies.Count()} proxy addresses." : "Copy failed. Check browser clipboard permissions.";
    }

    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void ResetPage() => _page = 1;

    private sealed record SessionResponse(string Email, string? Role, string[]? Permissions = null);
    private sealed record ProxyEntry(string Address, string Protocol);
    private sealed record ProxyListResponse(List<ProxyEntry> Proxies, DateTimeOffset FetchedAt);
    private sealed record PinnedProxyResponse(string Address, string Protocol, DateTime PinnedUtc, DateTime? LastCheckedUtc, long? LatencyMilliseconds, bool? IsHealthy);
}
