@page "/dashboard/files"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Files · ContentManagement</PageTitle>

@if (_checkingSession)
{
    <div class="dashboard-loading">Checking administrator session…</div>
}
else if (!_signedIn)
{
    <div class="dashboard-loading">Your session has expired. Redirecting…</div>
}
else
{
    <div class="dashboard-page files-page">
        <aside class="dashboard-sidebar">
            <a class="dashboard-brand" href="/dashboard"><span class="dashboard-logo">CM</span><span>ContentManagement</span></a>
            <p class="sidebar-label">WORKSPACE</p><a class="sidebar-link" href="/dashboard"><span>⌂</span> Dashboard</a>
            <p class="sidebar-label">MANAGEMENT</p><a class="sidebar-link active" href="/dashboard/files"><span>▤</span> Files</a>
            <div class="sidebar-bottom"><div class="admin-avatar">A</div><div class="admin-identity"><strong>Administrator</strong><span>@_email</span></div></div>
        </aside>
        <main class="dashboard-main files-main">
            <header class="dashboard-header"><div><p class="dashboard-eyebrow">CONTENT MANAGEMENT</p><h1>Files</h1><p class="dashboard-subtitle">Upload, preview and manage binary assets.</p></div>
                <button class="files-upload-button" @onclick="OpenUpload" disabled="@_busy">Upload file</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(_message)) { <div class="files-message" role="status">@_message</div> }
            <div class="files-workspace">
                <section class="files-list-panel">
                    <div class="files-toolbar"><input aria-label="Search files" placeholder="Search by filename or SHA-256…" @bind="_search" @bind:event="oninput" @onkeydown="SearchKeyDown" /><select aria-label="Filter status" @bind="_status" @bind:after="LoadAsync"><option value="">All statuses</option><option>Active</option><option>MarkedForDeletion</option><option>Deleting</option><option>Uploading</option></select><button class="files-secondary" @onclick="LoadAsync">Search</button></div>
                    @if (_loading) { <p class="files-empty">Loading files…</p> }
                    else if (_items.Count == 0) { <p class="files-empty">No files found. Upload a file to get started.</p> }
                    else {
                        <div class="files-table-wrap"><table class="files-table"><thead><tr><th>File</th><th>File path</th><th>Size</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody>
                        @foreach (var item in _items) { <tr class="@(_selected?.Id == item.Id ? "selected" : "")" @key="item.Id"><td data-label="File"><button class="files-name" @onclick="() => SelectAsync(item)"><span class="file-type">@IconFor(item.ContentType)</span><span><strong>@item.FileName</strong><small>@item.ContentType</small></span></button></td><td data-label="File path" class="hash-value">@item.FilePath</td><td data-label="Size">@FormatSize(item.SizeBytes)</td><td data-label="Status"><span class="file-status">@item.Status</span></td><td data-label="Created">@item.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd")</td><td data-label="Actions"><button class="files-secondary" @onclick="() => OpenViewUrl(item)">View URL</button></td></tr> }
                        </tbody></table></div>
                        <div class="files-pagination"><span>@_total files · Page @_page</span><button class="files-secondary" @onclick="PreviousAsync" disabled="@(_page <= 1 || _loading)">Previous</button><button class="files-secondary" @onclick="NextAsync" disabled="@(_page * _pageSize >= _total || _loading)">Next</button></div>
                    }
                </section>
                <section class="files-preview-panel">
                    @if (_selected is null) { <div class="files-preview-placeholder"><span>▤</span><h2>Select a file</h2><p>Preview and metadata will appear here.</p></div> }
                    else {
                        <div class="files-preview-heading"><div><p class="dashboard-eyebrow">FILE PREVIEW</p><h2>@_selected.FileName</h2><p>@FormatSize(_selected.SizeBytes) · @_selected.ContentType</p></div>
                            @if (_selected.Status == "MarkedForDeletion")
                            {
                                <button class="setup-primary" @onclick="RestoreAsync" disabled="@_busy">Restore</button>
                            }
                            else if (_selected.Status == "Active")
                            {
                                <button class="files-danger" @onclick="() => _confirmDelete = true" disabled="@_busy">Delete</button>
                            }
                        </div>
                        <div class="files-preview-content">
                            @if (IsImage(_selected.ContentType)) { <img class="files-image-preview" src="@ContentUrl(_selected.Id)" alt="@_selected.FileName" /> }
                            else if (IsPdf(_selected.ContentType)) { <iframe class="files-pdf-preview" src="@ContentUrl(_selected.Id)" title="@_selected.FileName"></iframe> }
                            else if (IsAudio(_selected.ContentType)) { <audio class="files-video-preview" controls preload="metadata" src="@ContentUrl(_selected.Id)">Your browser does not support this audio format.</audio> }
                            else if (IsVideo(_selected.ContentType) || IsVideoExtension(_selected.FileName)) {
                                <video class="files-video-preview" controls preload="metadata" playsinline>
                                    <source src="@PreviewUrl(_selected)" type="@PreviewContentType(_selected)" />
                                    @if (!string.IsNullOrEmpty(_subtitleUrl)) { <track kind="subtitles" src="@_subtitleUrl" srclang="en" label="Uploaded subtitles" default /> }
                                    Your browser cannot play this video format or codec. Download the original file to view it in a compatible player.
                                </video>
                                <div class="subtitle-panel"><strong>Subtitles</strong><p>Choose a WebVTT (.vtt) subtitle file from this device for the current preview. It is not saved to the server.</p><label class="files-secondary subtitle-upload">Upload .vtt<InputFile OnChange="UploadSubtitleAsync" accept=".vtt,text/vtt" disabled="@_busy" /></label>@if (!string.IsNullOrEmpty(_subtitleMessage)){<p>@_subtitleMessage</p>}</div>
                            }
                            else if (IsText(_selected.ContentType)) { <pre class="files-text-preview">@_textPreview</pre> }
                            else { <div class="files-preview-placeholder"><span>↓</span><h2>Preview unavailable</h2><p>This file type cannot be previewed in the browser.</p><a class="files-secondary download-link" href="@DownloadUrl(_selected.Id)">Download file</a></div> }
                        </div>
                        <div class="files-metadata"><h3>Details</h3><dl><dt>File ID</dt><dd>@_selected.Id</dd><dt>File path</dt><dd class="hash-value">@_selected.FilePath</dd><dt>SHA-256</dt><dd class="hash-value">@_selected.Sha256</dd><dt>Owner</dt><dd>@(_selected.OwnerId ?? "—")</dd><dt>Created</dt><dd>@_selected.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd><dt>Status</dt><dd>@_selected.Status</dd></dl>
                        <button class="files-secondary" @onclick="OpenRename" disabled="@_busy">Edit display name</button>
                        <a class="files-secondary download-link" href="@DownloadUrl(_selected.Id)">Download original</a></div>
                    }
                </section>
            </div>
        </main>
        @if (_viewUrlOpen && _viewUrlItem is not null)
        {
            <div class="cm-modal-backdrop" role="presentation" @onclick="CloseViewUrl">
                <section class="cm-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="view-url-title" @onclick:stopPropagation="true">
                    <h2 id="view-url-title">View file by URL</h2>
                    <p>@_viewUrlItem.FileName</p>
                    <label for="file-view-url">Signed URL (expires in 15 minutes)</label>
                    <input id="file-view-url" class="files-url-input" readonly value="@_viewUrl" />
                    <div class="setup-actions">
                        <button class="files-secondary" @onclick="CloseViewUrl">Close</button>
                        <button class="files-secondary" @onclick="CopyViewUrlAsync">Copy URL</button>
                        <button class="setup-primary" @onclick="OpenViewUrlInNewTab">Open URL</button>
                    </div>
                </section>
            </div>
        }
        @if (_uploadOpen)
        {
            <div class="cm-modal-backdrop" role="presentation" @onclick="CloseUpload">
                <section class="cm-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="upload-title" @onclick:stopPropagation="true">
                    <h2 id="upload-title">Upload file</h2>
                    <p>Select a file to upload to ContentManagement. Maximum size: 100 MiB.</p>
                    <InputFile OnChange="UploadAsync" disabled="@_busy" />
                    @if (_pendingUpload is not null) { <p><strong>@_pendingUpload.Name</strong> · @FormatSize(_pendingUpload.Size)</p> }
                    <div class="setup-actions">
                        <button class="files-secondary" @onclick="CloseUpload" disabled="@_busy">Cancel</button>
                        <button class="setup-primary" @onclick="UploadSelectedAsync" disabled="@(_busy || _pendingUpload is null)">Upload</button>
                    </div>
                </section>
            </div>
        }
        @if (_renameOpen && _selected is not null)
        {
            <div class="cm-modal-backdrop" role="presentation" @onclick="CloseRename">
                <section class="cm-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="rename-title" @onclick:stopPropagation="true">
                    <h2 id="rename-title">Edit display name</h2>
                    <EditForm Model="_rename" OnValidSubmit="RenameAsync">
                        <label for="rename-file">Display name</label>
                        <InputText id="rename-file" @bind-Value="_rename.FileName" maxlength="255" />
                        <div class="setup-actions">
                            <button class="files-secondary" type="button" @onclick="CloseRename" disabled="@_busy">Cancel</button>
                            <button class="setup-primary" type="submit" disabled="@_busy">Save changes</button>
                        </div>
                    </EditForm>
                </section>
            </div>
        }
        @if (_confirmDelete && _selected is not null)
        {
            <div class="cm-modal-backdrop" role="presentation" @onclick="() => _confirmDelete = false">
                <section class="cm-confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="file-delete-title" @onclick:stopPropagation="true">
                    <h2 id="file-delete-title">Mark file for deletion?</h2>
                    <p><strong>@_selected.FileName</strong> will be marked for deletion and removed by the cleanup job after the grace period.</p>
                    <div class="setup-actions">
                        <button class="files-secondary" @onclick="() => _confirmDelete = false" disabled="@_busy">Cancel</button>
                        <button class="files-danger" @onclick="DeleteAsync" disabled="@_busy">Confirm delete</button>
                    </div>
                </section>
            </div>
        }
    </div>
}

@code {
    private bool _checkingSession = true, _signedIn, _loading, _busy;
    private bool _uploadOpen, _renameOpen, _confirmDelete, _viewUrlOpen;
    private FileItem? _viewUrlItem;
    private string _viewUrl = "";
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? _pendingUpload;
    private string _email = "", _message = "", _subtitleMessage = "", _search = "", _status = "";
    private string? _textPreview, _subtitleUrl;
    private int _page = 1, _pageSize = 25;
    private long _total;
    private List<FileItem> _items = [];
    private FileItem? _selected;
    private RenameModel _rename = new();
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);

    protected override async Task OnInitializedAsync() {
        try { using var response = await Http.GetAsync("api/auth/me"); if(response.IsSuccessStatusCode) { var session = await response.Content.ReadFromJsonAsync<SessionResponse>(); _email=session?.Email??""; _signedIn=!string.IsNullOrWhiteSpace(_email); } }
        catch(HttpRequestException) { _message="Unable to connect to the server."; }
        finally { _checkingSession=false; }
        if(!_signedIn) { Navigation.NavigateTo("/", replace:true); return; }
        await LoadAsync();
    }
    private async Task LoadAsync() {
        _loading=true; _message="";
        try {
            var url=$"api/files?page={_page}&pageSize={_pageSize}";
            if(!string.IsNullOrWhiteSpace(_search)) url += "&search="+Uri.EscapeDataString(_search.Trim());
            if(!string.IsNullOrWhiteSpace(_status)) url += "&status="+Uri.EscapeDataString(_status);
            using var response=await Http.GetAsync(url);
            if(response.IsSuccessStatusCode) { var data=await response.Content.ReadFromJsonAsync<FileListResponse>(); _items=data?.Items??[]; _total=data?.Total??0; if(_selected is not null) _selected=_items.FirstOrDefault(x=>x.Id==_selected.Id); }
            else _message=response.StatusCode==System.Net.HttpStatusCode.Forbidden ? "The current session cannot access file management." : "Unable to load files. Check the server configuration.";
        } catch(HttpRequestException) { _message="Unable to connect to the server."; }
        finally { _loading=false; }
    }
    private async Task SelectAsync(FileItem item) {
        if (!string.IsNullOrEmpty(_subtitleUrl)) await JS.InvokeVoidAsync("contentManagementFiles.revokeSubtitleUrl", _subtitleUrl);
        _selected=item; _rename.FileName=item.FileName; _textPreview=null; _subtitleUrl=null; _subtitleMessage="";
        if(IsText(item.ContentType) && item.SizeBytes <= 256*1024) {
            try { _textPreview=await Http.GetStringAsync(ContentUrl(item.Id)); }
            catch(HttpRequestException) { _textPreview="Preview could not be loaded."; }
        }
    }
    private Task UploadAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs args)
    {
        _pendingUpload = args.File;
        return Task.CompletedTask;
    }

    private void OpenUpload() { _pendingUpload = null; _uploadOpen = true; }
    private void CloseUpload() { if (_busy) return; _uploadOpen = false; _pendingUpload = null; }

    private async Task UploadSelectedAsync()
    {
        var file = _pendingUpload;
        if (file is null || _busy) return;
        _busy = true;
        _message = "";
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = file.OpenReadStream(100 * 1024 * 1024);
            var part = new StreamContent(stream);
            part.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
            content.Add(part, "file", file.Name);
            using var response = await Http.PostAsync("api/files", content);
            if (response.IsSuccessStatusCode)
            {
                _message = "File uploaded.";
                _page = 1;
                _uploadOpen = false;
                _pendingUpload = null;
                await LoadAsync();
            }
            else _message = response.StatusCode == System.Net.HttpStatusCode.RequestEntityTooLarge ? "File exceeds the upload limit." : "Upload failed. Check file size and server permissions.";
        }
        catch (HttpRequestException) { _message = "Upload failed. Unable to connect to the server."; }
        catch (IOException) { _message = "Upload failed. The file may exceed the browser upload limit."; }
        finally { _busy = false; }
    }

    private void OpenRename() { if (_selected is null) return; _rename.FileName = _selected.FileName; _renameOpen = true; }
    private void CloseRename() { if (_busy) return; _renameOpen = false; }

    private async Task UploadSubtitleAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs args) {
        if (_selected is null || !(IsVideo(_selected.ContentType) || IsVideoExtension(_selected.FileName))) return;
        var file=args.File;
        if (!file.Name.EndsWith(".vtt", StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrWhiteSpace(file.ContentType) && file.ContentType != "text/vtt" && file.ContentType != "application/octet-stream")) {
            _subtitleMessage="Only WebVTT (.vtt) subtitles are supported.";
            return;
        }
        if (file.Size > 1024 * 1024) { _subtitleMessage="Subtitle file must be 1 MiB or smaller."; return; }
        try {
            await using var stream=file.OpenReadStream(1024*1024);
            using var reader=new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks:true);
            var text=await reader.ReadToEndAsync();
            if (!text.TrimStart().StartsWith("WEBVTT", StringComparison.Ordinal)) {
                _subtitleMessage="Invalid WebVTT file. The file must begin with WEBVTT.";
                return;
            }
            _subtitleUrl=await JS.InvokeAsync<string>("contentManagementFiles.createSubtitleUrl", new object?[] { text });
            _subtitleMessage="Subtitle loaded for this preview.";
        } catch(Exception ex) when(ex is IOException or Microsoft.JSInterop.JSException) {
            _subtitleMessage="Unable to load subtitle file.";
        }
    }
    private async Task RenameAsync() {
        if(_selected is null) return; _busy=true;
        try { using var response=await Http.PatchAsJsonAsync($"api/files/{_selected.Id}",new { fileName=_rename.FileName, rowVersion=_selected.RowVersion }); if(response.IsSuccessStatusCode){_message="File name updated.";_renameOpen=false; await LoadAsync();}else _message=response.StatusCode==System.Net.HttpStatusCode.Conflict?"This file changed. Refresh and retry.":"Unable to rename file."; }
        catch(HttpRequestException){_message="Unable to connect to the server.";} finally{_busy=false;}
    }
    private async Task RestoreAsync()
    {
        if (_selected is null || _selected.Status != "MarkedForDeletion" || _busy) return;
        _busy = true;
        try
        {
            using var response = await Http.PostAsync($"api/files/{_selected.Id}/restore", content: null);
            if (response.IsSuccessStatusCode)
            {
                _message = "File restored.";
                await LoadAsync();
            }
            else
            {
                _message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "This file can no longer be restored. Refresh the list."
                    : "Unable to restore file.";
            }
        }
        catch (HttpRequestException) { _message = "Unable to connect to the server."; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync() {
        if(_selected is null || !_confirmDelete) return; _busy=true;
        try { using var response=await Http.DeleteAsync($"api/files/{_selected.Id}"); if(response.IsSuccessStatusCode){_message="File marked for deletion.";_selected=null;_confirmDelete=false;await LoadAsync();}else _message="Unable to delete file."; }
        catch(HttpRequestException){_message="Unable to connect to the server.";} finally{_busy=false;}
    }
    private async Task SearchKeyDown(KeyboardEventArgs e) { if(e.Key=="Enter"){_page=1;await LoadAsync();} }
    private async Task PreviousAsync(){if(_page>1){_page--;await LoadAsync();}}
    private async Task NextAsync(){if(_page*_pageSize<_total){_page++;await LoadAsync();}}
    private void OpenViewUrl(FileItem item)
    {
        _viewUrlItem = item;
        _viewUrl = item.ViewUrl ?? "";
        _viewUrlOpen = !string.IsNullOrWhiteSpace(_viewUrl);
        if (!_viewUrlOpen) _message = "No view URL is available for this file. Refresh the list or check server configuration.";
    }
    private void CloseViewUrl() { _viewUrlOpen = false; _viewUrlItem = null; _viewUrl = ""; }
    private async Task CopyViewUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_viewUrl)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _viewUrl); _message = "View URL copied. It expires in 15 minutes."; }
        catch (JSException) { _message = "Unable to copy automatically. Select and copy the URL manually."; }
    }
    private async Task OpenViewUrlInNewTab()
    {
        if (string.IsNullOrWhiteSpace(_viewUrl)) return;
        await JS.InvokeVoidAsync("open", new object?[] { _viewUrl, "_blank", "noopener,noreferrer" });
    }
    private string ContentUrl(Guid id)=>$"api/files/{id}/content";
    private string DownloadUrl(Guid id)=>$"api/files/{id}/download";
    private string PreviewUrl(FileItem file)=>IsWmv(file.FileName) ? $"api/files/{file.Id}/preview" : ContentUrl(file.Id);
    private static bool IsImage(string t)=>t.StartsWith("image/",StringComparison.OrdinalIgnoreCase)&&!t.Equals("image/svg+xml",StringComparison.OrdinalIgnoreCase);
    private static bool IsPdf(string t)=>t.Equals("application/pdf",StringComparison.OrdinalIgnoreCase);
    private static bool IsVideo(string t)=>t.StartsWith("video/",StringComparison.OrdinalIgnoreCase);
    private static bool IsWmv(string fileName)=>Path.GetExtension(fileName).Equals(".wmv",StringComparison.OrdinalIgnoreCase); 
    private static string PreviewContentType(FileItem file) =>
        IsWmv(file.FileName) ? "video/mp4" :
        file.ContentType.Equals("application/octet-stream", StringComparison.OrdinalIgnoreCase) ||
        string.IsNullOrWhiteSpace(file.ContentType)
            ? Path.GetExtension(file.FileName).ToLowerInvariant() switch
            {
                ".mp4" or ".m4v" => "video/mp4",
                ".webm" => "video/webm",
                ".ogv" or ".ogg" => "video/ogg",
                ".mov" => "video/quicktime",
                _ => file.ContentType
            }
            : file.ContentType;
    private static bool IsAudio(string t)=>t.StartsWith("audio/",StringComparison.OrdinalIgnoreCase);
    private static bool IsVideoExtension(string fileName) =>
        Path.GetExtension(fileName).ToLowerInvariant() is ".mp4" or ".m4v" or ".webm" or ".ogv" or ".ogg" or ".mov" or ".wmv";
    private static bool IsText(string t)=>t.StartsWith("text/",StringComparison.OrdinalIgnoreCase)||t is "application/json" or "application/xml" or "application/javascript";
    private static string IconFor(string t)=>t.StartsWith("image/")?"IMG":t=="application/pdf"?"PDF":t.StartsWith("video/")?"VID":t.StartsWith("audio/")?"AUD":t.StartsWith("text/")||t=="application/json"?"TXT":"FILE";
    private static string FormatSize(long n)=>n<1024?$"{n} B":n<1024*1024?$"{n/1024d:0.#} KB":n<1024L*1024*1024?$"{n/(1024d*1024):0.#} MB":$"{n/(1024d*1024*1024):0.#} GB";
    private sealed record SessionResponse(string Email, string? Role);
    private sealed record FileListResponse(List<FileItem> Items,long Total,int Page,int PageSize);
    private sealed record FileItem(Guid Id,string FileName,string FilePath,string ContentType,long SizeBytes,string Sha256,string Status,string? OwnerId,DateTime CreatedUtc,DateTime UpdatedUtc,string RowVersion,string ViewUrl);
    private sealed class RenameModel { public string FileName {get;set;}=""; }
}
