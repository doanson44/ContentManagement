@page "/"
@using System.Net
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Sign in · ContentManagement</PageTitle>

<section class="login-shell">
    <div class="login-brand">
        <div class="brand-mark">CM</div>
        <p class="eyebrow">CONTENT MANAGEMENT</p>
        <h1>Sign in to your workspace</h1>
        <p class="login-subtitle">Secure, passwordless access for invited users and administrators.</p>
    </div>

    @if (_signedIn)
    {
        <div class="login-card">
            <div class="status-icon">✓</div>
            <h2>Signed in successfully</h2>
            <p class="muted">Opening your administrator dashboard…</p>
        </div>
    }
    else if (!_otpRequested)
    {
        <div class="login-card">
            <h2>Continue with email</h2>
            <p class="muted">Enter the email address associated with your account. We’ll send you a one-time code.</p>
            <label for="email">Email address</label>
            <input id="email" type="email" autocomplete="email" maxlength="254" @bind="_email" @bind:event="oninput" placeholder="you@company.com" disabled="@_busy" />
            @if (!string.IsNullOrWhiteSpace(_message)) { <p class="form-message error">@_message</p> }
            <button class="primary-button" @onclick="RequestOtpAsync" disabled="@_busy">@(_busy ? "Sending code…" : "Continue with email")</button>
            <p class="fine-print">Administrators are configured by the server. New users can <a href="/register">create an account</a> with email verification.</p>
        </div>
    }
    else
    {
        <div class="login-card">
            <button class="text-button" @onclick="BackToEmail" disabled="@_busy">← Change email</button>
            <h2>Check your inbox</h2>
            <p class="muted">Enter the six-digit code sent to <strong>@_email</strong>.</p>
            <label for="otp">Verification code</label>
            <input id="otp" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" @bind="_code" @bind:event="oninput" placeholder="000000" disabled="@_busy" />
            @if (!string.IsNullOrWhiteSpace(_message)) { <p class="form-message @(_messageIsSuccess ? "success" : "error")">@_message</p> }
            <button class="primary-button" @onclick="VerifyOtpAsync" disabled="@_busy">@(_busy ? "Verifying…" : "Verify and sign in")</button>
            <button class="secondary-button" @onclick="RequestOtpAsync" disabled="@_busy">Send a new code</button>
            <p class="fine-print">The code expires after a short period and can only be used once.</p>
        </div>
    }
    <footer>Protected administrator access · ContentManagement</footer>
</section>

@code {
    private string _email = "";
    private string _code = "";
    private string _message = "";
    private bool _messageIsSuccess;
    private bool _otpRequested;
    private bool _signedIn;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var response = await Http.GetAsync("api/auth/me");
            if (response.IsSuccessStatusCode)
            {
                var session = await response.Content.ReadFromJsonAsync<SessionResponse>();
                if (!string.IsNullOrWhiteSpace(session?.Email))
                {
                    _email = session.Email;
                    _signedIn = true;
                    Navigation.NavigateTo("/dashboard", replace: true);
                }
            }
        }
        catch (HttpRequestException)
        {
            _message = "Unable to connect to the server. Please try again.";
        }
    }

    private async Task RequestOtpAsync()
    {
        _message = "";
        _messageIsSuccess = false;
        if (!new EmailAddressAttribute().IsValid(_email))
        {
            _message = "Enter a valid email address.";
            return;
        }

        _busy = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/request-otp", new { Email = _email.Trim() });
            if (response.IsSuccessStatusCode)
            {
                _otpRequested = true;
                _code = "";
                _message = "If this address is eligible, a sign-in code will be sent.";
                _messageIsSuccess = true;
            }
            else
            {
                _message = await ReadErrorAsync(response);
            }
        }
        catch (HttpRequestException)
        {
            _message = "Unable to connect to the server. Please try again.";
        }
        finally { _busy = false; }
    }

    private async Task VerifyOtpAsync()
    {
        _message = "";
        _messageIsSuccess = false;
        if (_code.Length != 6 || _code.Any(character => character is < '0' or > '9'))
        {
            _message = "Enter the six-digit code from your email.";
            return;
        }

        _busy = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/verify-otp", new { Email = _email.Trim(), Code = _code });
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/dashboard", forceLoad: true, replace: true);
                return;
            }
            else
            {
                _message = await ReadErrorAsync(response);
            }
        }
        catch (HttpRequestException)
        {
            _message = "Unable to connect to the server. Please try again.";
        }
        finally { _busy = false; }
    }

    private async Task LogoutAsync()
    {
        _busy = true;
        try
        {
            using var response = await Http.PostAsync("api/auth/logout", null);
            if (response.IsSuccessStatusCode)
            {
                _signedIn = false;
                _otpRequested = false;
                _code = "";
                _message = "";
            }
            else _message = "Unable to sign out. Please try again.";
        }
        catch (HttpRequestException) { _message = "Unable to connect to the server. Please try again."; }
        finally { _busy = false; }
    }

    private void BackToEmail()
    {
        _otpRequested = false;
        _code = "";
        _message = "";
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>();
            return error?.Message ?? error?.Title ?? (response.StatusCode == HttpStatusCode.TooManyRequests
                ? "Too many attempts. Wait a few minutes and try again."
                : "The request could not be completed. Please try again.");
        }
        catch { return "The request could not be completed. Please try again."; }
    }

    private sealed record SessionResponse(string Email);
    private sealed record ApiError(string? Message, string? Title);
}
