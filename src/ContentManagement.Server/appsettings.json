{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/contentmanagement-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ContentManagement": "Server=localhost;Database=ContentManagement;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5"
  },
  "ContentManagement": {
    "MaxUploadBytes": 104857600,
    "MaxJsonDocumentBytes": 10485760
  },
  "Authentication": { "Scopes": [] },
  "AdminAuth": {
    "AllowedEmails": [],
    "OtpLifetimeMinutes": 10,
    "MaxVerificationAttempts": 5,
    "ResendCooldownSeconds": 60,
    "SessionLifetimeHours": 8
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "ContentManagement"
  },
  "Hangfire": {
    "Enabled": true
  }
}
